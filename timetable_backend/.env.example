PORT=3000
NODE_ENV="development"
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/timetable_db?schema=public"

# Generate independent random secrets; never commit real values.
JWT_SECRET="replace-with-at-least-32-random-characters"
TICKET_QR_SECRET="replace-with-another-32-character-secret"
CORS_ORIGINS="http://localhost:3000,http://localhost:8080"

# Xendit Payment Session (server-side secret values from Xendit Dashboard).
XENDIT_SECRET_KEY=""
XENDIT_WEBHOOK_TOKEN=""
XENDIT_API_URL="https://api.xendit.co"
XENDIT_SUCCESS_RETURN_URL="https://example.com/payment/success"
XENDIT_CANCEL_RETURN_URL="https://example.com/payment/cancel"

# Optional official/provider-approved realtime integration.
KAI_REALTIME_API_URL=""
KAI_REALTIME_API_TOKEN=""

# Optional Gemini travel assistant / camera vision (server-side only).
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_VISION_MODEL="gemini-3.5-flash-lite"
